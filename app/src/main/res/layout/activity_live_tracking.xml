<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageButton
        android:id="@+id/btnRecenter"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/ic_navigation_arrow"
        android:background="@drawable/button_circle"
        android:padding="10dp"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/txtEta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ETA: -- | Distance: --"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:padding="10dp"
        android:background="#CCFFFFFF"
        android:elevation="8dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/txtSpeed"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:text="0\nkm/h"
        android:textStyle="bold"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:background="@drawable/speed_circle"
        android:elevation="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtEta"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>